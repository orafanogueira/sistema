# ==============================================
# Grupo Nogueira OS - Variaveis de Ambiente
# Copie para .env.local e preencha
# ==============================================

# --- App
NEXT_PUBLIC_APP_URL=https://gruponogueiramkt.com
NEXT_PUBLIC_APP_NAME="Grupo Nogueira OS"

# --- Supabase (obrigatorio pra rodar)
# Crie conta em supabase.com -> new project -> Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Meta (Facebook/Instagram/WhatsApp/Messenger)
# business.facebook.com > Configuracoes > Usuarios do sistema > Gerar token
# Permissoes: ads_read, ads_management, business_management, pages_messaging, instagram_manage_messages, whatsapp_business_messaging
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_API_VERSION=v20.0

# --- Google (Ads + Analytics + Calendar + Gmail + GTM)
# console.cloud.google.com > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://gruponogueiramkt.com/api/integracoes/google-oauth/callback
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Z-API (WhatsApp ja configurado)
ZAPI_INSTANCE_ID=3F171D0728DBE3D3960DBA4D31290A14
ZAPI_INSTANCE_TOKEN=0C5C484A9A4A885A78E6C403
ZAPI_CLIENT_TOKEN=F41915b265ce141bc8bdb4bb65facda4fS

# --- Claude (Anthropic) - IA de atendimento
# console.anthropic.com > Settings > API Keys
ANTHROPIC_API_KEY=

# --- Email (Resend - melhor custo/beneficio)
# resend.com - 100 emails/dia free, $20/mes pra 50k
# Inbound parser: criar dominio leads.gruponogueiramkt.com
# Ou usar SendGrid (Inbound Parse) ou MailerSend (mais barato em escala)
RESEND_API_KEY=
LEADS_INBOUND_DOMAIN=leads.gruponogueiramkt.com

# SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Creditas (financiamento - sandbox)
# https://developers.creditas.com
CREDITAS_API_KEY=
CREDITAS_PARTNER_ID=

# --- Portais automotivos (configurar por cliente, nao global)
# Cada cliente tem suas credenciais em portais_integracoes

# --- Cron (Vercel cron secrets)
CRON_SECRET=
